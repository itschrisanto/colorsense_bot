# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Base origin of the deployed ColorSense API server, e.g. https://api.colorsense.online
# Do NOT include a trailing /api — the client appends /api/palettes itself.
COLORSENSE_API_BASE_URL=

# Telegram chat ID that receives the startup notification (your own DM with the bot, or an admin chat)
ADMIN_CHAT_ID=

# Supabase project — used for persistent tester registry, usage analytics, and feedback log.
# SUPABASE_SERVICE_KEY is the project's "secret" (service_role) key — full trusted access,
# never expose this client-side. Get both from Settings -> API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional — real-time error alerting via Sentry. Leave blank to disable;
# the bot runs fine without it. Get this from your Sentry project's
# Settings -> Client Keys (DSN).
SENTRY_DSN=

# Optional — a bot-only service credential for ColorSense's account-linking
# and AI-usage endpoints (powers /link). Leave blank until that API side
# exists; /link degrades to "not available yet" without it.
TELEGRAM_LINK_API_KEY=

# Discord bot skeleton — a separate process from the Telegram bot (run via
# `npm run start:discord`). Get the token from the Discord Developer Portal
# (Bot -> Reset Token). GUILD_ID is the test server's ID, used for instant
# guild-scoped slash-command registration. ADMIN_USER_ID receives a DM on
# startup, same role as ADMIN_CHAT_ID on the Telegram side.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_USER_ID=

# Optional — lets ops/health-check.sh check in with Sentry's Crons product,
# so a missed or failed daily run gets caught even if the machine can't
# self-report over Telegram. Get this from the monitor's page in Sentry ->
# Guide: cURL -> the ${SENTRY_CRONS} value.
SENTRY_CRON_URL=
