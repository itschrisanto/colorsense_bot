# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Base origin of the deployed ColorSense API server, e.g. https://api.colorsense.online
# Do NOT include a trailing /api — the client appends /api/palettes itself.
COLORSENSE_API_BASE_URL=

# Telegram chat ID that receives the startup notification (your own DM with the bot, or an admin chat)
ADMIN_CHAT_ID=
