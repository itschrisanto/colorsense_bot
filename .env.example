# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Base origin of the deployed ColorSense API server, e.g. https://api.colorsense.online
# Do NOT include a trailing /api — the client appends /api/palettes itself.
COLORSENSE_API_BASE_URL=

# Telegram chat ID that receives the startup notification (your own DM with the bot, or an admin chat)
ADMIN_CHAT_ID=

# Supabase project — used for persistent tester registry, usage analytics, and feedback log.
# SUPABASE_SERVICE_KEY is the project's "secret" (service_role) key — full trusted access,
# never expose this client-side. Get both from Settings -> API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional — real-time error alerting via Sentry. Leave blank to disable;
# the bot runs fine without it. Get this from your Sentry project's
# Settings -> Client Keys (DSN).
SENTRY_DSN=
