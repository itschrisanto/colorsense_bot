<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chrisantomendez.colorsense-companion-bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>dist/index.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/chrisantomendez/colorsense-companion-bot</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/chrisantomendez/Library/Logs/colorsense-companion-bot/stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/chrisantomendez/Library/Logs/colorsense-companion-bot/stderr.log</string>
</dict>
</plist>
